# ============================================================================
# SHMIFTING KITCHEN — environment
#
# Copy the AUTH_SECRET line into .env.local (gitignored).
# The API keys belong in .env (also gitignored, and off limits to agents —
# see CLAUDE.md §0.3).
# ============================================================================

# --- required ---------------------------------------------------------------
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- asset pipeline (optional at runtime; the artwork is committed) ---------
# Generates Shmifting artwork. scripts/generate-assets.mjs
OPENAI_API_KEY=
# Animates artwork that already exists. Never creates it. scripts/animate-assets.mjs
FAL_KEY=

# --- production database (optional; defaults to a local SQLite file) --------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
